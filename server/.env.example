# Copy to .env if you want, or export these in the shell. No secrets go in this file.
PORT=8787
RPC_URL=https://api.devnet.solana.com
# Path of the authority keypair (the wallet that deployed the program). Never commit it.
AUTHORITY_KEYPAIR_PATH=../.devnet-wallet.json
DEVNET_CONFIG=../devnet-config.json
# Extra allowed browser origins, comma separated (the dev web origins are always allowed).
ALLOWED_ORIGINS=
# Devnet test helpers: bots that fill rooms and a token faucet.
DEV_BOTS=1
# Round length in ms (protocol default 60000).
MATCH_MS=60000
